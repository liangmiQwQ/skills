{
  "name": "{{repo}}",
  "version": "0.0.0",
  "description": "{{description}}",
  "homepage": "https://github.com/{{owner}}/{{repo}}#readme",
  "bugs": {
    "url": "https://github.com/{{owner}}/{{repo}}/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{owner}}/{{repo}}.git"
  },
  "bin": {
    "{{repo}}": "./bin/{{repo}}.mjs"
  },
  "files": ["dist", "bin"],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "release": "bumpp",
    "test": "vp run ctest --passWithNoTests"
  }
}
